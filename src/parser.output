Terminals which are not used

   TOKEN_FOR
   TOKEN_REQUIRES
   TOKEN_ENSURE
   TOKEN_HASH
   TOKEN_ERROR


Grammar

    0 $accept: program $end

    1 program: opt_newlines statement_list

    2 opt_newlines: /* empty */
    3             | opt_newlines TOKEN_NEWLINE

    4 statement_list: statement
    5               | statement_list statement
    6               | statement_list TOKEN_NEWLINE

    7 statement: simple_stmt TOKEN_NEWLINE
    8          | compound_stmt

    9 simple_stmt: sensor_decl
   10            | output_decl
   11            | var_decl
   12            | let_decl
   13            | return_stmt
   14            | invariant_decl
   15            | emit_decl
   16            | extern_decl
   17            | unsafe_block
   18            | transition_decl
   19            | assignment

   20 compound_stmt: rule_decl
   21              | if_stmt
   22              | every_decl
   23              | fn_decl
   24              | machine_decl
   25              | state_decl
   26              | on_enter_decl
   27              | init_decl

   28 suite: TOKEN_NEWLINE TOKEN_INDENT statement_list TOKEN_DEDENT

   29 assignment: TOKEN_IDENTIFIER TOKEN_ASSIGN expr

   30 sensor_decl: TOKEN_SENSOR TOKEN_IDENTIFIER TOKEN_IDENTIFIER TOKEN_IDENTIFIER opt_range opt_poll
   31            | TOKEN_SENSOR TOKEN_IDENTIFIER TOKEN_IDENTIFIER TOKEN_LPAREN expr TOKEN_RPAREN TOKEN_ARROW type_expr opt_poll

   32 output_decl: TOKEN_OUTPUT TOKEN_IDENTIFIER TOKEN_IDENTIFIER TOKEN_IDENTIFIER opt_state

   33 opt_range: /* empty */
   34          | TOKEN_RANGE expr TOKEN_DOT TOKEN_DOT expr

   35 opt_poll: /* empty */
   36         | TOKEN_AT TOKEN_IDENTIFIER TOKEN_ASSIGN expr

   37 opt_state: /* empty */
   38          | TOKEN_ON
   39          | TOKEN_OFF

   40 var_decl: TOKEN_VAR TOKEN_IDENTIFIER TOKEN_COLON type_expr TOKEN_ASSIGN expr
   41         | TOKEN_VAR TOKEN_IDENTIFIER TOKEN_COLON TOKEN_LBRACKET type_expr TOKEN_SEMICOLON TOKEN_INTEGER TOKEN_RBRACKET TOKEN_ASSIGN TOKEN_LBRACKET expr TOKEN_SEMICOLON TOKEN_INTEGER TOKEN_RBRACKET

   42 let_decl: TOKEN_LET TOKEN_IDENTIFIER TOKEN_ASSIGN expr

   43 type_expr: TOKEN_IDENTIFIER
   44          | TOKEN_FIXED TOKEN_LT TOKEN_IDENTIFIER TOKEN_COMMA TOKEN_IDENTIFIER TOKEN_GT

   45 rule_decl: TOKEN_RULE TOKEN_STRING TOKEN_COLON suite

   46 if_stmt: TOKEN_IF expr TOKEN_COLON suite opt_else

   47 opt_else: /* empty */
   48         | TOKEN_ELSE TOKEN_COLON suite
   49         | TOKEN_ELSE TOKEN_IF expr TOKEN_COLON suite opt_else

   50 every_decl: TOKEN_EVERY expr TOKEN_COLON suite

   51 fn_decl: TOKEN_FN TOKEN_IDENTIFIER TOKEN_LPAREN param_list TOKEN_RPAREN TOKEN_ARROW type_expr TOKEN_COLON suite

   52 param_list: /* empty */
   53           | param
   54           | param_list TOKEN_COMMA param

   55 param: TOKEN_IDENTIFIER TOKEN_COLON type_expr

   56 return_stmt: TOKEN_RETURN expr
   57            | TOKEN_RETURN

   58 machine_decl: TOKEN_MACHINE TOKEN_IDENTIFIER TOKEN_COLON suite

   59 state_decl: TOKEN_STATE TOKEN_IDENTIFIER TOKEN_COLON suite
   60           | TOKEN_INITIAL TOKEN_STATE TOKEN_IDENTIFIER TOKEN_COLON suite

   61 on_enter_decl: TOKEN_ON_ENTER TOKEN_COLON suite

   62 transition_decl: TOKEN_TRANSITION TOKEN_TO TOKEN_IDENTIFIER TOKEN_WHEN expr
   63                | TOKEN_TRANSITION TOKEN_TO TOKEN_IDENTIFIER TOKEN_AFTER expr

   64 invariant_decl: TOKEN_INVARIANT TOKEN_STRING TOKEN_COLON expr

   65 emit_decl: TOKEN_EMIT TOKEN_IDENTIFIER TOKEN_LPAREN expr_list TOKEN_RPAREN TOKEN_TO TOKEN_IDENTIFIER TOKEN_LPAREN TOKEN_STRING TOKEN_RPAREN

   66 init_decl: TOKEN_INIT TOKEN_COLON suite

   67 extern_decl: TOKEN_EXTERN TOKEN_STRING TOKEN_FN TOKEN_IDENTIFIER TOKEN_LPAREN param_list TOKEN_RPAREN TOKEN_ARROW type_expr

   68 unsafe_block: TOKEN_UNSAFE TOKEN_LBRACE TOKEN_STRING TOKEN_RBRACE

   69 expr: primary_expr
   70     | expr TOKEN_PLUS expr
   71     | expr TOKEN_MINUS expr
   72     | expr TOKEN_STAR expr
   73     | expr TOKEN_SLASH expr
   74     | expr TOKEN_PERCENT expr
   75     | expr TOKEN_LT expr
   76     | expr TOKEN_GT expr
   77     | expr TOKEN_LTE expr
   78     | expr TOKEN_GTE expr
   79     | expr TOKEN_EQ expr
   80     | expr TOKEN_NEQ expr
   81     | TOKEN_NOT expr
   82     | TOKEN_MINUS expr
   83     | TOKEN_IDENTIFIER TOKEN_QUESTION
   84     | expr TOKEN_IS TOKEN_IDENTIFIER
   85     | expr TOKEN_IS TOKEN_ON
   86     | expr TOKEN_IS TOKEN_OFF

   87 primary_expr: TOKEN_IDENTIFIER
   88             | TOKEN_INTEGER
   89             | TOKEN_FLOAT
   90             | TOKEN_ON
   91             | TOKEN_OFF
   92             | TOKEN_MS
   93             | TOKEN_TRUE
   94             | TOKEN_FALSE
   95             | TOKEN_LPAREN expr TOKEN_RPAREN
   96             | TOKEN_IDENTIFIER TOKEN_LPAREN expr_list TOKEN_RPAREN

   97 expr_list: expr
   98          | expr_list TOKEN_COMMA expr


